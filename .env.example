# Copy to .env (chmod 600) or fill in interactively with set-secrets.sh.
BOT_TOKEN=
CF_ACCOUNT_ID=
CF_API_TOKEN=
TYPESAFE_API_KEY=
# Optional: Combot API key; without it the CAS check is skipped.
CAS_API_KEY=
# Telegram user IDs that get reports and may use /check and /stats, comma-separated.
ADMIN_IDS=
# Optional: one sentence about the group, given to the classifier as context.
GROUP_DESCRIPTION=
# true: only report, never delete or ban.
DRY_RUN=true
BAN_THRESHOLD=0.9
DELETE_THRESHOLD=0.7
# Clean messages after which a member is no longer checked.
TRUST_AFTER=3
JEV_MODEL=jev-latest
# Reply to every new channel post with rules.txt.
POST_RULES=true
